<Project Sdk="Microsoft.NET.Sdk">
  <!-- Machine-local game path. Optional, so builds without it still succeed and skip the deploy step. -->
  <Import Condition="Exists('..\SilksongPath.props')" Project="..\SilksongPath.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <RootNamespace>CustomCrest</RootNamespace>
    <AssemblyName>CustomCrest</AssemblyName>
    <Version>4.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);MSB3270;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.9.0" />
    <PackageReference Include="Needleforge" Version="0.9.0" />
    <PackageReference Include="Silksong.FsmUtil" Version="0.3.16" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" />
    <PackageReference Include="Silksong.GameLibs" Version="1.2.0-silksong1.0.30000" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestComposition\CrestComposition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Custom_Crest.png">
      <LogicalName>CustomCrest.Custom_Crest.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="CustomCrestSilhouette.png">
      <LogicalName>CustomCrest.CustomCrestSilhouette.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Copies the built plugin flat into BepInEx/plugins, replacing the previously installed CustomCrest.dll. -->
  <Target Name="DeployToSilksong" AfterTargets="PostBuildEvent" Condition="'$(SilksongFolder)' != '' And Exists('$(SilksongFolder)\BepInEx\plugins')">
    <ItemGroup>
      <DeployBinaries Include="$(TargetPath)" />
      <DeployBinaries Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <DeployBinaries Include="$(TargetDir)CrestComposition.dll" />
      <DeployBinaries Include="$(TargetDir)CrestComposition.pdb" Condition="Exists('$(TargetDir)CrestComposition.pdb')" />
      <InstalledNeedleforge Include="$(SilksongFolder)\BepInEx\plugins\**\Needleforge.dll" />
      <InstalledFsmUtil Include="$(SilksongFolder)\BepInEx\plugins\**\Silksong.FsmUtil.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployBinaries)" DestinationFolder="$(SilksongFolder)\BepInEx\plugins" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="CustomCrest deployed to $(SilksongFolder)\BepInEx\plugins" />
    <Warning Condition="'@(InstalledNeedleforge)' == ''" Text="Needleforge is not installed under BepInEx\plugins, so CustomCrest will not load in-game." />
    <Warning Condition="'@(InstalledFsmUtil)' == ''" Text="Silksong.FsmUtil is not installed under BepInEx\plugins, so CustomCrest will not load in-game." />
  </Target>

  <!-- Builds the Thunderstore zip: dotnet build CustomCrest/CustomCrest.csproj -c Release -t:PackageThunderstore -->
  <Target Name="PackageThunderstore" DependsOnTargets="Build">
    <PropertyGroup>
      <ThunderstoreSource>$(MSBuildProjectDirectory)\thunderstore\</ThunderstoreSource>
      <ThunderstoreStage>$(MSBuildProjectDirectory)\$(OutputPath)thunderstore\</ThunderstoreStage>
    </PropertyGroup>
    <Error Condition="!Exists('$(ThunderstoreSource)icon.png')" Text="Add a 256x256 PNG at CustomCrest\thunderstore\icon.png. Thunderstore rejects a package without it." />
    <RemoveDir Directories="$(ThunderstoreStage)" />
    <ItemGroup>
      <ThunderstoreFiles Include="$(ThunderstoreSource)manifest.json;$(ThunderstoreSource)README.md;$(ThunderstoreSource)CHANGELOG.md;$(ThunderstoreSource)icon.png" />
      <ThunderstorePlugins Include="$(TargetPath);$(TargetDir)CrestComposition.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ThunderstoreFiles)" DestinationFolder="$(ThunderstoreStage)" />
    <Copy SourceFiles="@(ThunderstorePlugins)" DestinationFolder="$(ThunderstoreStage)plugins" />
    <ZipDirectory SourceDirectory="$(ThunderstoreStage)" DestinationFile="$(MSBuildProjectDirectory)\$(OutputPath)CustomCrest-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(MSBuildProjectDirectory)\$(OutputPath)CustomCrest-$(Version).zip" />
  </Target>

  <!-- Builds the Nexus zip, extracted over the game folder: dotnet build CustomCrest/CustomCrest.csproj -c Release -t:PackageNexus -p:SilksongFolder= -->
  <Target Name="PackageNexus" DependsOnTargets="Build">
    <PropertyGroup>
      <NexusStage>$(MSBuildProjectDirectory)\$(OutputPath)nexus\</NexusStage>
      <NexusZip>$(MSBuildProjectDirectory)\$(OutputPath)CustomCrest-$(Version)-Nexus.zip</NexusZip>
    </PropertyGroup>
    <RemoveDir Directories="$(NexusStage)" />
    <ItemGroup>
      <NexusPlugins Include="$(TargetPath);$(TargetDir)CrestComposition.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NexusPlugins)" DestinationFolder="$(NexusStage)BepInEx\plugins" />
    <ZipDirectory SourceDirectory="$(NexusStage)" DestinationFile="$(NexusZip)" Overwrite="true" />
    <Message Importance="high" Text="Nexus package: $(NexusZip)" />
  </Target>
</Project>
